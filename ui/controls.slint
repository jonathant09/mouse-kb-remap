// Controls that talk to the Store directly.

import { Theme } from "theme.slint";
import { Store } from "store.slint";
import { Button, ChoiceGrid } from "widgets.slint";

// Click, then press a key or combo. While waiting, the engine swallows the
// next key press and reports it (so Win, Alt+Tab, PrintScreen etc. work).
export component CaptureBox inherits Rectangle {
    in property <string> target;   // "binding", "turbo", "step"
    in property <string> value;
    in property <string> placeholder: "Click, then press a key";
    property <bool> active: Store.capturing == root.target;

    height: 40px;
    border-radius: Theme.radius;
    background: Theme.input-bg;
    border-width: 1px;
    border-color: root.active ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.active ? "Press a key or combo…" : root.value != "" ? root.value : root.placeholder;
            color: root.active ? Theme.accent : root.value != "" ? Theme.text-strong : Theme.text-faint;
            font-size: root.value != "" && !root.active ? Theme.font-md : Theme.font;
            font-weight: root.value != "" && !root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.active: Text {
        x: parent.width - self.width - 10px;
        text: "click to cancel";
        color: Theme.text-faint;
        font-size: Theme.font-xs;
        vertical-alignment: center;
        height: parent.height;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.active {
                Store.cancel-capture();
            } else {
                Store.start-capture(root.target);
            }
        }
    }
}

// Ctrl / Shift / Alt / Win toggles.
export component ModifierChips inherits HorizontalLayout {
    in property <string> target;
    in property <int> mods;
    spacing: 4px;

    pure function has(bit: int) -> bool {
        Math.mod(Math.floor(root.mods / bit), 2) == 1
    }

    for m in [{ name: "Ctrl", bit: 1 }, { name: "Shift", bit: 2 }, { name: "Alt", bit: 4 }, { name: "Win", bit: 8 }]: Rectangle {
        horizontal-stretch: 1;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: root.has(m.bit) ? Theme.accent-soft : (mta.has-hover ? Theme.control-hover : Theme.input-bg);
        border-width: 1px;
        border-color: root.has(m.bit) ? Theme.accent : transparent;
        Text {
            text: (root.has(m.bit) ? "✓ " : "+ ") + m.name;
            font-size: Theme.font-sm;
            color: root.has(m.bit) ? Theme.accent : Theme.text-muted;
            font-weight: root.has(m.bit) ? 600 : 400;
        }
        mta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Store.toggle-mod(root.target, m.bit); }
        }
    }
}

// "Label ........ [field]" row.
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> field-width: 110px;
    spacing: 8px;
    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    HorizontalLayout {
        width: root.field-width;
        @children
    }
}

// "Choose from a list": pick a key with the mouse instead of pressing it
// (a broken key, a key the keyboard doesn't have, no keyboard at hand).
export component KeyPicker inherits VerticalLayout {
    in property <string> target;   // same targets as CaptureBox
    property <bool> open: Store.picker-target == root.target;
    spacing: 6px;

    HorizontalLayout {
        alignment: start;
        Button {
            text: root.open ? "Hide the key list" : "Choose from a list";
            compact: true;
            clicked => { Store.toggle-picker(root.target); }
        }
    }
    if root.open: ChoiceGrid {
        columns: 3;
        cell-height: 24px;
        items: Store.picker-groups;
        current: Store.picker-group;
        selected(i) => { Store.pick-group(i); }
    }
    if root.open: ChoiceGrid {
        columns: Store.picker-columns;
        items: Store.picker-keys;
        current: Store.picker-current;
        selected(i) => { Store.pick-key(root.target, i); }
    }
}

// The virtual controller's driver and state, with the install button when
// the driver is missing.
export component VpadStatus inherits VerticalLayout {
    spacing: 8px;
    Rectangle {
        border-radius: Theme.radius;
        background: (Store.vpad-state == 0 || Store.vpad-state == 3 ? Theme.warning : Theme.success).with-alpha(0.12);
        border-width: 1px;
        border-color: (Store.vpad-state == 0 || Store.vpad-state == 3 ? Theme.warning : Theme.success).with-alpha(0.35);
        VerticalLayout {
            padding: 8px;
            spacing: 8px;
            Text {
                text: Store.vpad-text;
                wrap: word-wrap;
                color: Theme.text;
                font-size: Theme.font-sm;
            }
            if Store.vpad-state == 0 || Store.vpad-state == 4: HorizontalLayout {
                alignment: start;
                Button {
                    text: Store.vpad-state == 4 ? "Installing…" : "Install controller driver";
                    primary: true;
                    enabled: Store.vpad-state == 0;
                    clicked => { Store.install-vpad-driver(); }
                }
            }
        }
    }
}
