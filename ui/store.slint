// App state shared by every view. Rust owns the data: it sets these
// properties after every change (see `refresh()` in src/app.rs) and handles
// the callbacks. Components read from here instead of passing props down.

import { MouseBtn } from "mouse.slint";
import { KeyCap } from "keyboard.slint";

export struct ProfileItem {
    name: string,
    apps: string,   // summary line, e.g. "GenshinImpact.exe"
    live: bool,     // currently active because its app is focused
    count: int,     // number of bindings
}

export struct MacroItem {
    name: string,
    summary: string, // "6 steps · used by 2 profiles"
}

export struct BindingRow {
    input-id: string,
    input: string,
    action: string,
    layer: int,      // 0 base, 1 shift
}

export struct StepRow {
    kind: string,    // "Key down"
    value: string,   // "A"
    delay: bool,     // drawn lighter / indented
}

export global Store {
    // ---- navigation ------------------------------------------------------------
    in-out property <int> view;            // 0 profile, 1 macro, 2 settings
    in property <[ProfileItem]> profiles;
    in property <int> selected-profile;
    in property <[MacroItem]> macros;
    in property <int> selected-macro: -1;
    in property <string> version;

    // ---- profile editor ----------------------------------------------------------
    in property <string> profile-name;
    in property <[string]> profile-apps;
    in property <[string]> recent-apps;
    in-out property <int> device-tab;      // 0 mouse, 1 keyboard
    in property <int> layer;               // 0 base, 1 shift, 2-3
    in property <[string]> layer-names: ["Base", "Shift", "Layer 2", "Layer 3"];
    in property <string> layer-banner;     // "SHIFT LAYER · hold Back to use"
    in property <bool> profile-fullscreen; // only while the app is fullscreen
    in property <bool> full-keyboard;
    in property <[KeyCap]> keys;
    in property <[MouseBtn]> mouse-buttons;
    in property <[BindingRow]> bindings;

    // ---- inspector ---------------------------------------------------------------------
    in-out property <int> inspector-tab;   // 0 selected input, 1 all bindings
    in property <string> selected-input;
    in property <string> selected-label;
    in property <string> selected-detail;
    in property <bool> selected-supported: true;
    // Action kind: 0 default, 1 key, 2 mouse, 3 macro, 4 turbo, 5 text,
    // 6 launch, 7 media, 8 layer, 9 sensitivity, 10 tap / hold, 11 system, 12 off
    in property <int> selected-kind;
    in property <string> inherited-value;
    in property <[string]> kind-items;     // choices shown (fewer inside a tap / hold)
    in property <int> kind-current: -1;    // index into kind-items

    // Editing a part of a tap / hold binding: 0 the binding itself, 1 tap, 2 hold, 3 double tap.
    in property <int> slot;
    in property <string> slot-title;       // "On tap"
    in property <string> taphold-tap;      // labels of the parts
    in property <string> taphold-hold;
    in property <string> taphold-double;
    in property <string> taphold-hold-ms;
    in property <string> taphold-double-ms;

    in property <int> layer-target: 1;     // layer a Layer action uses (1-3)
    in property <bool> layer-toggle;
    in property <[string]> system-names;
    in property <int> system-current: -1;

    // Combos (hold modifiers / another input, then press this one).
    in property <bool> selected-is-combo;
    in property <int> combo-mods;          // modifier bits held
    in property <[string]> combo-mouse-names: ["Nothing", "Left click", "Right click", "Wheel click", "Back", "Forward"];
    in property <int> combo-held-mouse;    // index into combo-mouse-names
    in property <string> combo-held-key;   // key held as well ("" none)
    in property <string> combo-trigger;    // label of the input pressed last
    in property <[BindingRow]> combos;     // combos ending in the selected input

    in property <string> key-value;        // "Ctrl + C"
    in property <int> key-mods;            // modifier bits: 1 ctrl, 2 shift, 4 alt, 8 win
    in property <int> shortcut-current: -1;
    in property <[string]> shortcut-names;
    in property <int> mouse-current: -1;
    in property <[string]> mouse-names;
    in property <int> media-current: -1;
    in property <[string]> media-names;

    in property <[string]> macro-names;
    in property <int> macro-current: -1;
    in property <int> macro-mode;          // 0 once, 1 repeat, 2 while held, 3 toggle
    in property <string> macro-count;
    in property <string> macro-gap;

    in property <bool> turbo-is-mouse;
    in property <string> turbo-key;
    in property <int> turbo-mods;
    in property <int> turbo-mouse: -1;
    in property <string> turbo-interval;
    in property <string> turbo-hold;
    in property <string> turbo-delay;
    in property <bool> turbo-toggle;
    in property <string> turbo-rate;

    in property <string> text-value;
    in property <string> text-delay;
    in property <string> launch-path;
    in property <string> launch-args;
    in property <int> sens-speed: 10;

    // Which capture box is waiting for a key ("" when none).
    in property <string> capturing;

    // ---- macro editor ----------------------------------------------------------
    in property <string> macro-name;
    in property <[StepRow]> steps;
    in property <int> selected-step: -1;
    in property <bool> recording;
    in property <string> macro-info;       // "Used by: …"
    in property <string> macro-jitter;     // random ± ms on every delay
    in property <[string]> step-kind-names: ["Key press", "Key down", "Key up", "Mouse click", "Mouse down", "Mouse up", "Delay", "Text", "Move by", "Move to"];
    in property <int> step-kind: -1;
    in property <string> step-key;
    in property <int> step-mouse: -1;
    in property <string> step-ms;
    in property <string> step-text;
    in property <string> step-x;
    in property <string> step-y;
    in property <bool> picking-position;   // "use pointer position" countdown running

    // ---- settings ------------------------------------------------------------------
    in property <int> autostart;           // 0 off, 1 on, 2 on as admin
    in property <bool> autostart-supported;
    in property <string> autostart-other;  // startup opens this other copy
    in property <bool> close-to-tray;
    in property <string> config-path;
    in property <string> notice;           // result of the last settings action
    in property <bool> notice-error;
    in property <[string]> hotkey-names;
    in property <[string]> hotkey-values;  // "" when not set
    in property <bool> notifications;      // on-screen notifications
    in property <bool> update-supported;   // can install updates itself
    in property <bool> check-updates;      // check automatically
    in property <string> update-status;    // result of the last check
    in property <string> update-available; // newer version, "" if none
    in property <bool> update-busy;
    in property <string> cli-help;         // command-line flags

    // ---- status bar ----------------------------------------------------------------
    in property <string> focused-app;
    in property <string> live-profile;
    in property <bool> live-forced;        // profile chosen by hand
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> elevation-warning;
    in property <bool> self-elevated;
    in property <bool> engine-enabled: true;
    in property <bool> engine-supported: true;

    // ---- callbacks (handled in Rust) ----------------------------------------
    callback open-settings();
    callback select-profile(int);
    callback add-profile();
    callback duplicate-profile();
    callback delete-profile();
    callback rename-profile(string);
    callback add-app(string);
    callback remove-app(string);
    callback select-layer(int);
    callback set-full-keyboard(bool);
    callback set-profile-fullscreen(bool);

    callback select-input(string);
    callback select-binding(string, int);  // input id, layer
    callback clear-binding(string, int);
    callback set-kind(int);                // index into kind-items
    callback edit-slot(int);               // 0 back to the binding, 1 tap, 2 hold, 3 double
    callback set-taphold-number(string, string); // field ("hold"/"double"), value
    callback set-layer-target(int);
    callback set-layer-toggle(bool);
    callback set-system(int);
    callback add-combo();
    callback remove-combo();
    callback back-to-trigger();
    callback set-combo-mouse(int);
    callback start-capture(string);        // "binding", "turbo", "step", "detect", "combo", "hotkey0"…
    callback cancel-capture();
    callback ui-key(string, bool, int);    // window capture: key text, released, modifier bits
    callback toggle-mod(string, int);      // target ("binding"/"turbo"/"combo"), bit
    callback set-shortcut(int);
    callback set-mouse-target(int);
    callback set-media(int);
    callback set-macro-choice(int);
    callback set-macro-mode(int);
    callback set-macro-number(string, string); // field ("count"/"gap"), value
    callback new-macro-for-binding();
    callback set-turbo-output(bool);       // true = mouse button, false = key
    callback set-turbo-mouse(int);
    callback set-turbo-number(string, string); // field ("interval"/"hold"/"delay"), value
    callback set-turbo-toggle(bool);
    callback set-text(string);
    callback set-text-delay(string);
    callback set-launch(string, string);
    callback browse-launch();
    callback set-sens(int);

    callback select-macro(int);
    callback add-macro();
    callback duplicate-macro();
    callback delete-macro();
    callback rename-macro(string);
    callback toggle-record();
    callback clear-steps();
    callback remove-delays();
    callback set-all-delays(string);
    callback add-step(int);                // index into step-kind-names
    callback select-step(int);
    callback set-step-kind(int);
    callback set-step-mouse(int);
    callback set-step-number(string);
    callback set-step-text(string);
    callback set-step-xy(string, string);
    callback pick-position();
    callback move-step(int);               // -1 up, +1 down
    callback duplicate-step();
    callback delete-step();
    callback set-macro-jitter(string);

    callback set-autostart(int);
    callback claim-autostart();            // point startup at this copy
    callback set-close-to-tray(bool);
    callback import-profiles();
    callback export-profile();
    callback export-all();
    callback open-config-folder();
    callback open-link(string);
    callback clear-hotkey(int);
    callback set-notifications(bool);
    callback preview-notification();
    callback set-check-updates(bool);
    callback check-update();
    callback install-update();
    callback open-release-page();

    callback toggle-enabled();
    callback auto-profile();
    callback undo();
    callback redo();
    callback set-theme(bool);

}
