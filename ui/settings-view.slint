// Settings page: startup, tray, import / export, config file, about.

import { Theme } from "theme.slint";
import { Store } from "store.slint";
import { Button, Callout, Divider, Hint, SectionLabel, Segmented, Switch, ValueField } from "widgets.slint";
import { CaptureBox } from "controls.slint";

component SwitchRow inherits HorizontalLayout {
    in property <string> text;
    in property <string> hint;
    in property <bool> checked;
    callback toggled(bool);
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Text { text: root.text; color: Theme.text; font-size: Theme.font; }
        if root.hint != "": Hint { text: root.hint; }
    }
    VerticalLayout {
        alignment: center;
        Switch {
            checked: root.checked;
            toggled(on) => { root.toggled(on); }
        }
    }
}

component Card inherits Rectangle {
    in property <string> title;
    border-radius: Theme.radius-lg;
    background: Theme.panel-bg;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        SectionLabel { text: root.title; }
        @children
    }
}

export component SettingsView inherits Rectangle {
    background: Theme.window-bg;

    Flickable {
        VerticalLayout {
            alignment: start;
            padding: 24px;
            spacing: 16px;

            Text { text: "Settings"; font-size: Theme.font-lg; font-weight: 700; color: Theme.text-strong; }
            if Store.notice != "": Text {
                max-width: 640px;
                text: Store.notice;
                wrap: word-wrap;
                color: Store.notice-error ? Theme.danger : Theme.success;
                font-size: Theme.font;
            }

            Card {
                title: "START WITH WINDOWS";
                max-width: 640px;
                Segmented {
                    items: ["Off", "On", "On, as administrator"];
                    current: Store.autostart;
                    selected(i) => { Store.set-autostart(i); }
                }
                if Store.autostart-other != "": Callout {
                    text: "Start with Windows opens another copy of the app: " + Store.autostart-other;
                }
                if Store.autostart-other != "": HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "Use this copy instead";
                        primary: true;
                        clicked => { Store.claim-autostart(); }
                    }
                }
                Hint {
                    text: !Store.autostart-supported ? "Not available on this system yet."
                        : "Starts hidden in the tray when you sign in. \"As administrator\" is needed for games that run as admin (Genshin Impact and many games with anti-cheat); it is set up with Task Scheduler and asks for admin rights once.";
                }
            }

            Card {
                title: "WINDOW";
                max-width: 640px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: "Keep running in the tray when the window is closed"; color: Theme.text; font-size: Theme.font; }
                        Hint { text: "Remapping keeps working in the background. Quit from the tray icon's menu."; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            checked: Store.close-to-tray;
                            toggled(on) => { Store.set-close-to-tray(on); }
                        }
                    }
                }
                Hint { text: "Switching to this window pauses remapping and stops any running macro or turbo, so it doubles as a panic button."; }
            }

            Card {
                title: "HOTKEYS";
                max-width: 640px;
                Hint { text: "Keys that control the app itself. They work everywhere, even while remapping is paused, and aren't passed on to the app in front."; }
                for name[i] in Store.hotkey-names: HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: name;
                        color: Theme.text;
                        font-size: Theme.font;
                        vertical-alignment: center;
                    }
                    CaptureBox {
                        width: 220px;
                        height: 32px;
                        target: "hotkey" + i;
                        value: Store.hotkey-values[i];
                        placeholder: "None (click to set)";
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Clear";
                            compact: true;
                            enabled: Store.hotkey-values[i] != "";
                            clicked => { Store.clear-hotkey(i); }
                        }
                    }
                }
            }

            Card {
                title: "DEVICES";
                max-width: 640px;
                Hint {
                    text: Store.keyboards-per-device
                        ? "Name a mouse, keyboard or controller to give it its own bindings: pick it under \"Bindings for\" at the top of a profile. Its own bindings win over the ones for all devices."
                        : "Name a mouse or controller to give it its own bindings: pick it under \"Bindings for\" at the top of a profile. Its own bindings win over the ones for all devices. Windows can't tell keyboards apart, so keys apply to every keyboard.";
                }
                for d[i] in Store.devices: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        TextInput {
                            text: d.name;
                            color: Theme.text-strong;
                            font-size: Theme.font;
                            font-weight: 600;
                            single-line: true;
                            selection-background-color: Theme.accent-soft;
                            accepted => { Store.rename-device(i, self.text); }
                            changed has-focus => {
                                if !self.has-focus && self.text != d.name { Store.rename-device(i, self.text); }
                            }
                        }
                        Text { text: d.detail; color: Theme.text-faint; font-size: Theme.font-xs; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button { text: "Remove"; compact: true; danger: true; clicked => { Store.remove-device(i); } }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button {
                        text: Store.adding-device ? "Cancel" : "Add a device";
                        primary: !Store.adding-device;
                        clicked => { Store.add-device(); }
                    }
                    if Store.adding-device: Text {
                        text: "Press a button or turn the wheel on the mouse or controller to add…";
                        color: Theme.accent;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                }
            }

            Card {
                title: "CONTROLLERS";
                max-width: 640px;
                HorizontalLayout {
                    spacing: 12px;
                    Text { horizontal-stretch: 1; text: "Button names on the drawing"; color: Theme.text; font-size: Theme.font; vertical-alignment: center; }
                    Segmented {
                        items: ["Xbox", "PlayStation", "Nintendo"];
                        current: Store.pad-labels;
                        selected(i) => { Store.set-pad-labels(i); }
                    }
                }
                Hint { text: "Buttons are matched by position, so the bottom face button is the same input on every controller (A, Cross, or B on Nintendo)."; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { horizontal-stretch: 1; text: "Gyro speed (1-20)"; color: Theme.text; font-size: Theme.font; vertical-alignment: center; }
                    ValueField { width: 60px; value: Store.pad-gyro-speed; committed(v) => { Store.set-pad-number("gyro", v); } }
                }
                SwitchRow {
                    text: "Invert gyro left / right";
                    checked: Store.pad-invert-x;
                    toggled(on) => { Store.set-pad-flag("invert_x", on); }
                }
                SwitchRow {
                    text: "Invert gyro up / down";
                    checked: Store.pad-invert-y;
                    toggled(on) => { Store.set-pad-flag("invert_y", on); }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Text { horizontal-stretch: 1; text: "Touchpad speed (1-20)"; color: Theme.text; font-size: Theme.font; vertical-alignment: center; }
                    ValueField { width: 60px; value: Store.pad-touch-speed; committed(v) => { Store.set-pad-number("touch", v); } }
                }
                Divider { }
                SwitchRow {
                    text: "Xbox-style controllers";
                    hint: "Xbox controllers and anything that works like one (XInput).";
                    checked: Store.pad-xinput;
                    toggled(on) => { Store.set-pad-flag("xinput", on); }
                }
                SwitchRow {
                    text: "PlayStation, Switch, Steam and other controllers";
                    hint: "Read directly over USB or Bluetooth, shared with games and Steam. Turn this off if a tool like DS4Windows already turns your controller into an Xbox one, so its buttons don't count twice.";
                    checked: Store.pad-direct;
                    toggled(on) => { Store.set-pad-flag("direct", on); }
                }
                SwitchRow {
                    text: "Skip Steam's virtual controllers";
                    hint: "While Steam Input is on, Steam adds an Xbox-style copy of your controller; the app reads the real one instead.";
                    checked: Store.pad-skip-steam;
                    toggled(on) => { Store.set-pad-flag("skip_steam", on); }
                }
                SwitchRow {
                    text: "Turn off the Steam Deck's / Steam Controller's own mouse mode";
                    hint: "Without Steam running, these move the mouse with the trackpads and click with the triggers by themselves. Turn this on when the app should be the only thing reading them.";
                    checked: Store.pad-lizard;
                    toggled(on) => { Store.set-pad-flag("lizard", on); }
                }
            }

            Card {
                title: "NOTIFICATIONS";
                max-width: 640px;
                SwitchRow {
                    text: "Show on-screen notifications";
                    hint: "A short note near the bottom of the screen when the profile changes, remapping is paused, or a toggle (turbo, macro, layer, microphone) goes on or off. Games in exclusive fullscreen draw over it.";
                    checked: Store.notifications;
                    toggled(on) => { Store.set-notifications(on); }
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Show an example"; clicked => { Store.preview-notification(); } }
                }
            }

            Card {
                title: "UPDATES";
                max-width: 640px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: Store.update-busy ? "Working…" : "Check for updates";
                        enabled: !Store.update-busy;
                        clicked => { Store.check-update(); }
                    }
                    if Store.update-available != "" && Store.update-supported: Button {
                        text: "Update to " + Store.update-available + " and restart";
                        primary: true;
                        enabled: !Store.update-busy;
                        clicked => { Store.install-update(); }
                    }
                    if Store.update-available != "": Button {
                        text: "What's new";
                        clicked => { Store.open-release-page(); }
                    }
                }
                if Store.update-status != "": Text {
                    text: Store.update-status;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: Theme.font-sm;
                }
                SwitchRow {
                    text: "Check automatically";
                    hint: "Looks for a new version when the app starts and once a day, and shows it here and in the sidebar. Nothing is installed without your click.";
                    checked: Store.check-updates;
                    toggled(on) => { Store.set-check-updates(on); }
                }
                Hint {
                    text: Store.update-supported
                        ? "Updating downloads the new version from GitHub, checks it, swaps it in and restarts the app (with the same admin rights). Your settings are kept."
                        : "On this system, download new versions from the releases page.";
                }
            }

            Card {
                title: "COMMAND LINE";
                max-width: 640px;
                Hint { text: "Control the running app from scripts, Stream Deck or AutoHotkey:"; }
                Text {
                    text: Store.cli-help;
                    color: Theme.text;
                    font-size: Theme.font-sm;
                    font-family: "Consolas";
                    wrap: word-wrap;
                }
            }

            Card {
                title: "PROFILES";
                max-width: 640px;
                Hint { text: "Share profiles or move them between PCs. Exports include every macro the profiles use. Imported profiles are added next to your own."; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Import…"; clicked => { Store.import-profiles(); } }
                    Button { text: "Export \"" + Store.profile-name + "\"…"; clicked => { Store.export-profile(); } }
                    Button { text: "Export all…"; clicked => { Store.export-all(); } }
                }
            }

            Card {
                title: "CONFIGURATION FILE";
                max-width: 640px;
                Text {
                    text: Store.config-path;
                    wrap: word-wrap;
                    color: Theme.text;
                    font-size: Theme.font-sm;
                }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Open folder"; clicked => { Store.open-config-folder(); } }
                }
                Hint { text: "Everything is saved as you change it. The folder also holds mouse-kb-remap.log, useful when reporting a problem."; }
            }

            Card {
                title: "ABOUT";
                max-width: 640px;
                Text { text: "mouse-kb-remap " + Store.version; color: Theme.text; font-size: Theme.font; }
                Hint { text: "Open source (MIT). Works with any mouse or keyboard."; }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: "github.com/jonathant09/mouse-kb-remap";
                        clicked => { Store.open-link("https://github.com/jonathant09/mouse-kb-remap"); }
                    }
                }
            }
        }
    }
}
