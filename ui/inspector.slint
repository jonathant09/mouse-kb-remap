// Right-hand panel of the profile editor: what the selected input does.

import { Theme } from "theme.slint";
import { Store, BindingRow } from "store.slint";
import { Button, Callout, ChoiceGrid, Divider, Hint, SectionLabel, Segmented, TextArea, ValueField } from "widgets.slint";
import { CaptureBox, FormRow, ModifierChips } from "controls.slint";

component KeyEditor inherits VerticalLayout {
    spacing: 8px;
    Hint { text: "Click the box, then press the key or combo to send (Ctrl + C, Alt + Tab…). Held for as long as the input is held."; }
    CaptureBox { target: "binding"; value: Store.key-value; }
    ModifierChips { target: "binding"; mods: Store.key-mods; }
    Rectangle { height: 2px; }
    SectionLabel { text: "COMMON SHORTCUTS"; }
    ChoiceGrid {
        columns: 2;
        cell-height: 24px;
        items: Store.shortcut-names;
        current: Store.shortcut-current;
        selected(i) => { Store.set-shortcut(i); }
    }
}

component MacroEditor inherits VerticalLayout {
    spacing: 8px;
    if Store.macro-names.length == 0: VerticalLayout {
        spacing: 8px;
        Hint { text: "No macros yet. A macro is a recorded or hand-built sequence of keys, clicks, delays and text."; }
        Button { text: "Create a macro"; primary: true; clicked => { Store.new-macro-for-binding(); } }
    }
    if Store.macro-names.length > 0: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            SectionLabel { text: "PLAYS"; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: "New macro…"; compact: true; clicked => { Store.new-macro-for-binding(); } }
        }
        ChoiceGrid {
            columns: 1;
            cell-height: 26px;
            items: Store.macro-names;
            current: Store.macro-current;
            selected(i) => { Store.set-macro-choice(i); }
        }
        Rectangle { height: 2px; }
        SectionLabel { text: "PLAYBACK"; }
        Segmented {
            items: ["Once", "Repeat", "While held", "Toggle"];
            current: Store.macro-mode;
            selected(i) => { Store.set-macro-mode(i); }
        }
        Hint {
            text: Store.macro-mode == 0 ? "Plays once per press."
                : Store.macro-mode == 1 ? "Plays a set number of times per press."
                : Store.macro-mode == 2 ? "Loops while the input is held and stops the moment you let go."
                : "First press starts looping, the next press stops it.";
        }
        if Store.macro-mode == 1: FormRow {
            label: "Times";
            ValueField { value: Store.macro-count; committed(v) => { Store.set-macro-number("count", v); } }
        }
        if Store.macro-mode != 0: FormRow {
            label: "Pause between repeats";
            ValueField { value: Store.macro-gap; suffix: "ms"; committed(v) => { Store.set-macro-number("gap", v); } }
        }
    }
}

component TurboEditor inherits VerticalLayout {
    spacing: 8px;
    SectionLabel { text: "PRESSES"; }
    Segmented {
        items: ["Key", "Mouse button"];
        current: Store.turbo-is-mouse ? 1 : 0;
        selected(i) => { Store.set-turbo-output(i == 1); }
    }
    if !Store.turbo-is-mouse: CaptureBox { target: "turbo"; value: Store.turbo-key; }
    if !Store.turbo-is-mouse: ModifierChips { target: "turbo"; mods: Store.turbo-mods; }
    if Store.turbo-is-mouse: ChoiceGrid {
        columns: 3;
        items: Store.mouse-names;
        current: Store.turbo-mouse;
        selected(i) => { Store.set-turbo-mouse(i); }
    }
    Rectangle { height: 2px; }
    SectionLabel { text: "TIMING"; }
    FormRow {
        label: "Press every (" + Store.turbo-rate + ")";
        ValueField { value: Store.turbo-interval; suffix: "ms"; committed(v) => { Store.set-turbo-number("interval", v); } }
    }
    FormRow {
        label: "Hold each press for";
        ValueField { value: Store.turbo-hold; suffix: "ms"; committed(v) => { Store.set-turbo-number("hold", v); } }
    }
    FormRow {
        label: "Start repeating after (0 = right away)";
        ValueField { value: Store.turbo-delay; suffix: "ms"; committed(v) => { Store.set-turbo-number("delay", v); } }
    }
    Segmented {
        items: ["While held", "Toggle on / off"];
        current: Store.turbo-toggle ? 1 : 0;
        selected(i) => { Store.set-turbo-toggle(i == 1); }
    }
    Hint {
        text: Store.turbo-toggle
            ? "Press once to start, again to stop. Switching apps or opening this window also stops it."
            : "Repeats while held. With a start delay it acts like keyboard auto-repeat: one press, a pause, then repeats.";
    }
    Callout {
        text: "Turbo and macros are against the rules in some online games. Check before using them in competitive play.";
    }
}

component TextEditor inherits VerticalLayout {
    spacing: 8px;
    Hint { text: "Typed out when the input is pressed. Works in any language (sent as Unicode); some games ignore Unicode input."; }
    TextArea {
        value: Store.text-value;
        placeholder: "Text to type…";
        edited(t) => { Store.set-text(t); }
    }
    FormRow {
        label: "Pause between characters";
        ValueField { value: Store.text-delay; suffix: "ms"; committed(v) => { Store.set-text-delay(v); } }
    }
}

component LaunchEditor inherits VerticalLayout {
    spacing: 8px;
    Hint { text: "Starts a program, or opens a file, folder or web address."; }
    HorizontalLayout {
        spacing: 6px;
        ValueField {
            horizontal-stretch: 1;
            live: true;
            value: Store.launch-path;
            placeholder: "C:\\…\\app.exe or https://…";
            committed(v) => { Store.set-launch(v, Store.launch-args); }
        }
        Button { text: "Browse…"; clicked => { Store.browse-launch(); } }
    }
    ValueField {
        live: true;
        value: Store.launch-args;
        placeholder: "Arguments (optional)";
        committed(v) => { Store.set-launch(Store.launch-path, v); }
    }
    Hint { text: "Programs start with the same rights as this app (admin if it runs as admin)."; }
}

component SensitivityEditor inherits VerticalLayout {
    spacing: 8px;
    Hint { text: "While held, the pointer moves at this speed, like a sniper / DPI-shift button. Your normal speed comes back on release."; }
    HorizontalLayout {
        spacing: 8px;
        Button { text: "−"; width: 32px; clicked => { Store.set-sens(Store.sens-speed - 1); } }
        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            border-radius: Theme.radius;
            background: Theme.input-bg;
            Rectangle {
                x: 0;
                width: parent.width * Store.sens-speed / 20;
                border-radius: Theme.radius;
                background: Theme.accent-soft;
            }
            Text {
                text: Store.sens-speed + " / 20";
                font-weight: 600;
                color: Theme.text-strong;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Store.set-sens(Math.max(1, Math.ceil(self.mouse-x / self.width * 20))); }
            }
        }
        Button { text: "+"; width: 32px; clicked => { Store.set-sens(Store.sens-speed + 1); } }
    }
    Hint { text: "This is the Windows pointer speed (10 is the default). Games that read raw mouse input ignore it."; }
}

component BindingList inherits Flickable {
    VerticalLayout {
        alignment: start;
        spacing: 1px;
        if Store.bindings.length == 0: Text {
            text: "No bindings in this profile yet.";
            color: Theme.text-faint;
            font-size: Theme.font-sm;
        }
        for b in Store.bindings: Rectangle {
            height: 30px;
            border-radius: Theme.radius-sm;
            background: b.input-id == Store.selected-input && b.layer == Store.layer ? Theme.selected-bg : (row-ta.has-hover ? Theme.control-hover : transparent);
            row-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { Store.select-binding(b.input-id, b.layer); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 6px;
                Text {
                    text: (b.layer == 1 ? "⇧ " : "") + b.input;
                    color: Theme.text;
                    font-size: Theme.font;
                    vertical-alignment: center;
                    width: 92px;
                    overflow: elide;
                }
                Text { text: "→"; color: Theme.text-faint; font-size: Theme.font; vertical-alignment: center; }
                Text {
                    text: b.action;
                    color: Theme.accent;
                    font-size: Theme.font;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Rectangle {
                    width: 22px;
                    border-radius: 2px;
                    background: del-ta.has-hover ? Theme.control-hover : transparent;
                    Text { text: "×"; font-size: Theme.font-md; color: del-ta.has-hover ? Theme.danger : Theme.text-faint; }
                    del-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Store.clear-binding(b.input-id, b.layer); }
                    }
                }
            }
        }
    }
}

export component Inspector inherits Rectangle {
    width: 300px;
    background: Theme.panel-bg;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Segmented {
            items: ["Selected input", "All bindings (" + Store.bindings.length + ")"];
            current: Store.inspector-tab;
            selected(i) => { Store.inspector-tab = i; }
        }

        if Store.inspector-tab == 1: BindingList { vertical-stretch: 1; }

        if Store.inspector-tab == 0: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 10px;

                if Store.selected-input == "": Hint {
                    text: "Click a button or key on the diagram to remap it.";
                    font-size: Theme.font;
                }
                if Store.selected-input != "": VerticalLayout {
                    spacing: 2px;
                    Text { text: Store.selected-label; font-size: Theme.font-md; font-weight: 700; color: Theme.text-strong; }
                    Text { text: Store.selected-detail; font-size: Theme.font-sm; color: Theme.text-faint; }
                }

                if Store.selected-input != "" && !Store.selected-supported: Callout {
                    tint: Theme.text-muted;
                    text: "This button is handled by the mouse's own firmware and never reaches Windows, so it can't be remapped in software.";
                }

                if Store.selected-input != "" && Store.selected-supported: VerticalLayout {
                    spacing: 10px;
                    Divider { }
                    SectionLabel { text: Store.layer == 1 ? "ACTION · SHIFT LAYER" : "ACTION"; }
                    ChoiceGrid {
                        items: Store.kind-names;
                        current: Store.selected-kind;
                        selected(i) => { Store.set-kind(i); }
                    }
                    Divider { }

                    if Store.selected-kind == 0: Hint {
                        text: Store.inherited-value != "" ? Store.inherited-value : "Not remapped: the input works as normal.";
                    }
                    if Store.selected-kind == 1: KeyEditor { }
                    if Store.selected-kind == 2: VerticalLayout {
                        spacing: 8px;
                        Hint { text: "Sends a mouse button or scroll step."; }
                        ChoiceGrid {
                            items: Store.mouse-names;
                            current: Store.mouse-current;
                            selected(i) => { Store.set-mouse-target(i); }
                        }
                    }
                    if Store.selected-kind == 3: MacroEditor { }
                    if Store.selected-kind == 4: TurboEditor { }
                    if Store.selected-kind == 5: TextEditor { }
                    if Store.selected-kind == 6: LaunchEditor { }
                    if Store.selected-kind == 7: VerticalLayout {
                        spacing: 8px;
                        Hint { text: "Media, volume and browser keys."; }
                        ChoiceGrid {
                            columns: 2;
                            items: Store.media-names;
                            current: Store.media-current;
                            selected(i) => { Store.set-media(i); }
                        }
                    }
                    if Store.selected-kind == 8: VerticalLayout {
                        spacing: 8px;
                        Hint { text: "While this input is held, the profile's shift layer is used: a second set of bindings for every other button and key (like G-Shift or Hypershift). Inputs with nothing on the shift layer keep their normal binding."; }
                        Button { text: "Edit the shift layer"; clicked => { Store.select-layer(1); } }
                    }
                    if Store.selected-kind == 9: SensitivityEditor { }
                    if Store.selected-kind == 10: Hint { text: "This input is blocked while the profile is active."; }
                }
            }
        }
    }
}
