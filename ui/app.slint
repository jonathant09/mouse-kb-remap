import { Theme } from "theme.slint";
import { Store, ProfileItem, MacroItem, BindingRow, StepRow } from "store.slint";
import { Dot } from "widgets.slint";
import { MouseBtn } from "mouse.slint";
import { KeyCap } from "keyboard.slint";
import { Sidebar } from "sidebar.slint";
import { ProfileView } from "profile-view.slint";
import { MacroView } from "macro-view.slint";
import { SettingsView } from "settings-view.slint";

export { Theme, Store, MouseBtn, KeyCap, ProfileItem, MacroItem, BindingRow, StepRow }

component StatusItem inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;
    spacing: 5px;
    Text { text: root.label; color: Theme.text-faint; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { text: root.value; color: root.value-color; font-size: Theme.font-sm; vertical-alignment: center; overflow: elide; }
}

component StatusBar inherits Rectangle {
    height: 28px;
    background: Theme.statusbar-bg;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 18px;

        // Engine on/off
        Rectangle {
            width: eng-row.preferred-width + 12px;
            border-radius: Theme.radius-sm;
            background: eng-ta.has-hover ? Theme.control-hover : transparent;
            eng-row := HorizontalLayout {
                x: 6px;
                spacing: 6px;
                Dot {
                    y: (parent.height - self.height) / 2;
                    tint: !Store.engine-supported ? Theme.text-faint : Store.engine-enabled ? Theme.success : Theme.warning;
                }
                Text {
                    text: !Store.engine-supported ? "Engine unavailable on this OS (UI preview)"
                        : Store.engine-enabled ? "Remapping on" : "Remapping paused";
                    color: Theme.text;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                }
            }
            eng-ta := TouchArea {
                enabled: Store.engine-supported;
                mouse-cursor: pointer;
                clicked => { Store.toggle-enabled(); }
            }
        }

        StatusItem { label: "Focused"; value: Store.focused-app != "" ? Store.focused-app : "—"; }
        StatusItem { label: "Active profile"; value: Store.live-profile; value-color: Theme.accent; }

        if Store.elevation-warning: HorizontalLayout {
            spacing: 6px;
            Dot { y: (parent.height - self.height) / 2; tint: Theme.warning; }
            Text {
                text: "Focused app runs as admin. Run this app as admin to remap it.";
                color: Theme.warning;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
        }

        Rectangle { horizontal-stretch: 1; }
        Text {
            text: Store.self-elevated ? "Admin" : "Standard user";
            color: Theme.text-faint;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "mouse-kb-remap";
    icon: @image-url("../assets/icon-64.png");
    preferred-width: 1220px;
    preferred-height: 760px;
    min-width: 1080px;
    min-height: 660px;
    background: Theme.window-bg;
    default-font-size: 12px;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            Sidebar { }
            Rectangle { width: 1px; background: Theme.border; }
            // Explicit max-width: otherwise a view whose content has a bounded
            // width would make the window shrink to fit it.
            if Store.view == 0: ProfileView { horizontal-stretch: 1; max-width: 100000px; }
            if Store.view == 1: MacroView { horizontal-stretch: 1; max-width: 100000px; }
            if Store.view == 2: SettingsView { horizontal-stretch: 1; max-width: 100000px; }
        }
        StatusBar { }
    }

    // Key capture through the window. The engine normally captures keys in
    // its input hook first (and swallows them); this catches anything it
    // doesn't, and is the only path where there is no engine.
    if Store.capturing != "": FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        key-pressed(event) => {
            Store.ui-key(event.text, false, root.mod-bits(event.modifiers));
            accept
        }
        key-released(event) => {
            Store.ui-key(event.text, true, root.mod-bits(event.modifiers));
            accept
        }
    }

    pure function mod-bits(m: KeyboardModifiers) -> int {
        (m.control ? 1 : 0) + (m.shift ? 2 : 0) + (m.alt ? 4 : 0) + (m.meta ? 8 : 0)
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <bool> remap-enabled: true;
    in property <string> status;
    callback show-window();
    callback toggle-enabled();
    callback quit();

    icon: @image-url("../assets/icon-32.png");
    tooltip: "mouse-kb-remap" + (root.status != "" ? " · " + root.status : "");
    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "Open mouse-kb-remap";
            activated => { root.show-window(); }
        }
        MenuItem {
            title: root.remap-enabled ? "Pause remapping" : "Resume remapping";
            activated => { root.toggle-enabled(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
