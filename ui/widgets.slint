import { Theme } from "theme.slint";

export component SectionLabel inherits Text {
    color: Theme.text-faint;
    font-size: Theme.font-xs;
    font-weight: 700;
    letter-spacing: 0.8px;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked;

    height: root.compact ? 24px : 28px;
    min-width: label.preferred-width + (root.compact ? 14px : 22px);
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.control-bg
        : root.primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.has-hover ? Theme.control-hover : Theme.control-bg);
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger && ta.has-hover ? Theme.danger : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 90ms; }

    label := Text {
        text: root.text;
        color: root.primary ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
        font-size: root.compact ? Theme.font-sm : Theme.font;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> removable: false;
    in property <bool> active: false;
    callback clicked;
    callback remove;

    height: 22px;
    // Never wider than its text, at most 200px, and it may shrink (the text
    // then ends in "…") when the row it's in runs out of room.
    min-width: layout.min-width;
    preferred-width: min(layout.preferred-width, 200px);
    max-width: layout.preferred-width;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.accent-soft : (ta.has-hover ? Theme.control-hover : Theme.input-bg);
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    layout := HorizontalLayout {
        padding-left: 8px;
        padding-right: root.removable ? 3px : 8px;
        spacing: 2px;
        Text {
            text: root.text;
            min-width: min(self.preferred-width, 48px);
            vertical-alignment: center;
            font-size: Theme.font-sm;
            color: root.active ? Theme.accent : Theme.text;
            overflow: elide;
        }
        if root.removable: Rectangle {
            width: 16px;
            border-radius: 2px;
            background: x-ta.has-hover ? Theme.control-hover : transparent;
            Text {
                text: "×";
                font-size: Theme.font-md;
                color: x-ta.has-hover ? Theme.danger : Theme.text-muted;
            }
            x-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.remove(); }
            }
        }
    }
}

// Small segmented control (Wooting / NuPhy style tabs).
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <length> item-min-width: 0px;
    callback selected(int);

    height: 28px;
    // Items stretch to fill the control, but the control itself keeps its
    // preferred width in horizontal layouts.
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: Theme.input-bg;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            min-width: max(root.item-min-width, lbl.preferred-width + 16px);
            horizontal-stretch: 1;
            border-radius: Theme.radius-sm;
            background: i == root.current ? Theme.control-bg : (t.has-hover ? Theme.control-hover.with-alpha(0.5) : transparent);
            drop-shadow-blur: i == root.current ? 2px : 0px;
            drop-shadow-color: i == root.current ? #0000001f : transparent;
            drop-shadow-offset-y: 1px;
            animate background { duration: 90ms; }
            lbl := Text {
                text: item;
                font-size: Theme.font;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.text-strong : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

// Grid of selectable cells, e.g. action kinds or mouse buttons.
export component ChoiceGrid inherits Rectangle {
    in property <[string]> items;
    in property <int> current: -1;
    in property <int> columns: 3;
    in property <length> cell-height: 28px;
    callback selected(int);

    property <length> gap: 4px;
    property <length> cell-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    height: Math.ceil(root.items.length / root.columns) * (root.cell-height + root.gap) - root.gap;

    for item[i] in root.items: Rectangle {
        x: Math.mod(i, root.columns) * (root.cell-width + root.gap);
        y: Math.floor(i / root.columns) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        border-radius: Theme.radius-sm;
        background: i == root.current ? Theme.accent-soft : (cell-ta.has-hover ? Theme.control-hover : Theme.input-bg);
        border-width: 1px;
        border-color: i == root.current ? Theme.accent : transparent;
        animate background { duration: 70ms; }
        Text {
            x: 6px;
            width: parent.width - 12px;
            text: item;
            font-size: Theme.font-sm;
            font-weight: i == root.current ? 600 : 400;
            color: i == root.current ? Theme.accent : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        cell-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback accepted(string);
    callback edited(string);

    height: 28px;
    border-radius: Theme.radius;
    background: Theme.input-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    if root.text == "": Text {
        x: 9px;
        width: parent.width - 18px;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.font;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        text <=> root.text;
        color: Theme.text;
        font-size: Theme.font;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.text-strong;
        accepted => { root.accepted(self.text); }
        edited => { root.edited(self.text); }
    }
}

// Text field bound to a value owned by Rust. Edits are reported with
// `committed` on Enter and when the field loses focus; the field then shows
// whatever Rust stored (so invalid input snaps back).
export component ValueField inherits Rectangle {
    in property <string> value;
    in property <string> suffix;
    in property <string> placeholder;
    in property <bool> live: false;   // report every keystroke
    callback committed(string);

    height: 28px;
    border-radius: Theme.radius;
    background: Theme.input-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    changed value => { input.text = root.value; }

    if input.text == "": Text {
        x: 9px;
        width: parent.width - 18px;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.font;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: 9px;
        width: parent.width - 18px - suffix-label.preferred-width;
        height: parent.height;
        text: root.value;
        color: Theme.text;
        font-size: Theme.font;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.text-strong;
        accepted => {
            root.committed(self.text);
            self.text = root.value;
        }
        edited => {
            if root.live { root.committed(self.text); }
        }
        changed has-focus => {
            if !self.has-focus && self.text != root.value {
                root.committed(self.text);
                self.text = root.value;
            }
        }
    }
    suffix-label := Text {
        x: parent.width - self.width - 9px;
        text: root.suffix;
        color: Theme.text-faint;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        height: parent.height;
    }
}

// Multi-line text box; reports every edit.
export component TextArea inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    callback edited(string);

    height: 76px;
    border-radius: Theme.radius;
    background: Theme.input-bg;
    border-width: 1px;
    border-color: area.has-focus ? Theme.accent : Theme.border;
    clip: true;

    changed value => {
        if area.text != root.value { area.text = root.value; }
    }

    if area.text == "": Text {
        x: 9px;
        y: 7px;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.font;
    }
    area := TextInput {
        x: 9px;
        y: 7px;
        width: parent.width - 18px;
        height: parent.height - 14px;
        text: root.value;
        single-line: false;
        wrap: word-wrap;
        color: Theme.text;
        font-size: Theme.font;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.text-strong;
        edited => { root.edited(self.text); }
    }
}

// On/off switch.
export component Switch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);

    width: 34px;
    height: 18px;
    border-radius: 9px;
    background: root.checked ? Theme.accent : Theme.border-strong;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// Status dot.
export component Dot inherits Rectangle {
    in property <color> tint: Theme.success;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.tint;
}

// Muted explanatory text that wraps.
export component Hint inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-sm;
    wrap: word-wrap;
}

// Coloured callout box (warnings, notes).
export component Callout inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.warning;

    border-radius: Theme.radius;
    background: root.tint.with-alpha(0.12);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.35);
    VerticalLayout {
        padding: 8px;
        Text {
            text: root.text;
            wrap: word-wrap;
            color: Theme.text;
            font-size: Theme.font-sm;
        }
    }
}
