import { Theme } from "theme.slint";
import { MouseBtn } from "mouse.slint";

// One clickable part of the drawing (button, trigger, stick, arrow).
component PadPart inherits Rectangle {
    in property <MouseBtn> btn;
    in property <bool> selected;
    in property <string> glyph;
    callback clicked;

    background: root.selected ? Theme.accent : (ta.has-hover ? Theme.device-part-hover : (root.btn.mapped ? Theme.accent-soft : Theme.input-bg));
    border-width: 1px;
    border-color: root.selected || root.btn.mapped ? Theme.accent : Theme.device-stroke;
    animate background, border-color { duration: 90ms; }

    Text {
        text: root.glyph;
        color: root.selected ? Theme.on-accent : (root.btn.mapped ? Theme.accent : Theme.text-muted);
        font-size: Theme.font-xs;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A row in the lists either side of the drawing.
component PadCallout inherits Rectangle {
    in property <MouseBtn> btn;
    in property <bool> selected;
    callback clicked;

    height: 26px;
    border-radius: Theme.radius;
    background: root.selected ? Theme.accent-soft : (ta.has-hover ? Theme.control-hover : Theme.panel-bg);
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    animate background, border-color { duration: 90ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            width: 62px;
            text: root.btn.label;
            font-size: Theme.font-xs;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            text: root.btn.value;
            font-size: Theme.font-sm;
            font-weight: 600;
            color: root.btn.mapped ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Generic game controller (Xbox layout) with every input listed either
// side. Button order follows PadButton::ALL (keep in sync with
// PAD_ORDER in src/app.rs): 0 A, 1 B, 2 X, 3 Y, 4 LB, 5 RB, 6 LT, 7 RT,
// 8 back, 9 start, 10 LS, 11 RS, 12-15 d-pad up/down/left/right,
// 16-19 left stick up/down/left/right, 20-23 right stick.
export component ControllerDiagram inherits Rectangle {
    in property <[MouseBtn]> buttons;
    // Short glyph per button for the drawing, in the chosen style ("×", "L1"…).
    in property <[string]> glyphs;
    in property <string> selected;
    // Space taken at the top by the tools drawn over the canvas.
    in property <length> top-inset: 100px;
    // Space kept free at the bottom (the legend under the canvas).
    in property <length> bottom-inset: 36px;
    callback select(string);

    property <length> cw: 170px;
    property <length> gap: 22px;
    property <length> row-h: 28px;
    // Wide: lists either side of the drawing. Compact (small window): the
    // drawing on top, the lists in two scrolling columns below it.
    property <bool> wide: root.width >= 2 * (root.cw + root.gap) + 280px
        && root.height - root.top-inset - root.bottom-inset >= 17 * root.row-h + 8px;
    // px per drawing unit (the controller is 300 x 200 units)
    property <length> s: root.wide
        ? max(0.6px, min(1.2px, (root.width - 2 * (root.cw + root.gap) - 24px) / 300))
        : max(0.45px, min(0.9px, min((root.width - 32px) / 300, (root.height - root.top-inset - root.bottom-inset) * 0.38 / 200)));
    property <length> pw: 300 * root.s;
    property <length> ph: 200 * root.s;
    property <length> px: (root.width - root.pw) / 2;
    property <length> list-top: root.wide
        ? max(root.top-inset, (root.height - root.bottom-inset - 17 * root.row-h) / 2)
        : root.top-inset + root.ph + 18px;
    property <length> py: root.wide
        ? root.list-top + (17 * root.row-h - root.ph) / 2
        : root.top-inset + 12px;

    property <[int]> left-list: [6, 4, 8, 25, 12, 13, 14, 15, 10, 16, 17, 18, 19, 28, 30, 32];
    property <[int]> right-list: [7, 5, 9, 24, 3, 2, 1, 0, 11, 20, 21, 22, 23, 29, 31, 26, 27];

    pure function is-sel(i: int) -> bool {
        root.buttons[i].id != "" && root.buttons[i].id == root.selected
    }

    // ---- the controller -------------------------------------------------
    Rectangle {
        x: root.px;
        y: root.py;
        width: root.pw;
        height: root.ph;

        // Body
        Path {
            y: 0;
            width: parent.width;
            height: parent.height;
            viewbox-width: 300;
            viewbox-height: 200;
            commands: "M 62 28 C 100 18 200 18 238 28 C 268 36 286 84 294 144 C 299 182 276 198 254 186 C 234 175 222 152 200 150 L 100 150 C 78 152 66 175 46 186 C 24 198 1 182 6 144 C 14 84 32 36 62 28 Z";
            fill: Theme.device-body;
            stroke: Theme.device-stroke;
            stroke-width: 1.5px;
        }

        // Triggers on top, bumpers over the top edge
        PadPart { x: 62 * root.s; y: -10 * root.s; width: 40 * root.s; height: 16 * root.s; border-radius: 5 * root.s; glyph: root.glyphs[6]; btn: root.buttons[6]; selected: root.is-sel(6); clicked => { root.select(root.buttons[6].id); } }
        PadPart { x: 198 * root.s; y: -10 * root.s; width: 40 * root.s; height: 16 * root.s; border-radius: 5 * root.s; glyph: root.glyphs[7]; btn: root.buttons[7]; selected: root.is-sel(7); clicked => { root.select(root.buttons[7].id); } }
        PadPart { x: 52 * root.s; y: 10 * root.s; width: 60 * root.s; height: 14 * root.s; border-radius: 7 * root.s; glyph: root.glyphs[4]; btn: root.buttons[4]; selected: root.is-sel(4); clicked => { root.select(root.buttons[4].id); } }
        PadPart { x: 188 * root.s; y: 10 * root.s; width: 60 * root.s; height: 14 * root.s; border-radius: 7 * root.s; glyph: root.glyphs[5]; btn: root.buttons[5]; selected: root.is-sel(5); clicked => { root.select(root.buttons[5].id); } }

        // Sticks: click in the middle, a direction on each side
        for stick in [{ cx: 82, cy: 74, base: 10, dirs: 16 }, { cx: 192, cy: 118, base: 11, dirs: 20 }]: Rectangle {
            Rectangle {
                x: (stick.cx - 21) * root.s;
                y: (stick.cy - 21) * root.s;
                width: 42 * root.s;
                height: 42 * root.s;
                border-radius: 21 * root.s;
                background: Theme.panel-bg;
                border-width: 1px;
                border-color: Theme.device-stroke;
            }
            PadPart {
                x: (stick.cx - 11) * root.s;
                y: (stick.cy - 11) * root.s;
                width: 22 * root.s;
                height: 22 * root.s;
                border-radius: 11 * root.s;
                glyph: root.glyphs[stick.base];
                btn: root.buttons[stick.base];
                selected: root.is-sel(stick.base);
                clicked => { root.select(root.buttons[stick.base].id); }
            }
            for d[i] in [{ dx: 0, dy: -16, g: "▲" }, { dx: 0, dy: 16, g: "▼" }, { dx: -16, dy: 0, g: "◀" }, { dx: 16, dy: 0, g: "▶" }]: PadPart {
                x: (stick.cx + d.dx - 5) * root.s;
                y: (stick.cy + d.dy - 5) * root.s;
                width: 10 * root.s;
                height: 10 * root.s;
                border-radius: 2 * root.s;
                glyph: "";
                btn: root.buttons[stick.dirs + i];
                selected: root.is-sel(stick.dirs + i);
                clicked => { root.select(root.buttons[stick.dirs + i].id); }
            }
        }

        // D-pad
        for d[i] in [{ x: 104, y: 102 }, { x: 104, y: 126 }, { x: 92, y: 114 }, { x: 116, y: 114 }]: PadPart {
            x: d.x * root.s;
            y: d.y * root.s;
            width: 12 * root.s;
            height: 12 * root.s;
            border-radius: 2 * root.s;
            glyph: "";
            btn: root.buttons[12 + i];
            selected: root.is-sel(12 + i);
            clicked => { root.select(root.buttons[12 + i].id); }
        }

        // Face buttons
        for f in [{ i: 3, x: 216, y: 52, g: "Y" }, { i: 2, x: 200, y: 68, g: "X" }, { i: 1, x: 232, y: 68, g: "B" }, { i: 0, x: 216, y: 84, g: "A" }]: PadPart {
            x: (f.x - 8) * root.s;
            y: (f.y - 8) * root.s;
            width: 16 * root.s;
            height: 16 * root.s;
            border-radius: 8 * root.s;
            glyph: root.glyphs[f.i];
            btn: root.buttons[f.i];
            selected: root.is-sel(f.i);
            clicked => { root.select(root.buttons[f.i].id); }
        }

        // Touchpad (PlayStation), Guide, Share / Capture, mic
        PadPart { x: 124 * root.s; y: 30 * root.s; width: 52 * root.s; height: 26 * root.s; border-radius: 5 * root.s; glyph: root.glyphs[26]; btn: root.buttons[26]; selected: root.is-sel(26); clicked => { root.select(root.buttons[26].id); } }
        PadPart { x: 141 * root.s; y: 82 * root.s; width: 18 * root.s; height: 18 * root.s; border-radius: 9 * root.s; glyph: root.glyphs[24]; btn: root.buttons[24]; selected: root.is-sel(24); clicked => { root.select(root.buttons[24].id); } }
        PadPart { x: 126 * root.s; y: 78 * root.s; width: 10 * root.s; height: 7 * root.s; border-radius: 3 * root.s; glyph: ""; btn: root.buttons[25]; selected: root.is-sel(25); clicked => { root.select(root.buttons[25].id); } }
        PadPart { x: 145 * root.s; y: 104 * root.s; width: 10 * root.s; height: 5 * root.s; border-radius: 2 * root.s; glyph: ""; btn: root.buttons[27]; selected: root.is-sel(27); clicked => { root.select(root.buttons[27].id); } }

        // Extra buttons (back paddles, SL / SR, L4-R5) on the grips
        for e in [{ i: 28, x: 56, y: 154 }, { i: 30, x: 70, y: 166 }, { i: 29, x: 230, y: 154 }, { i: 31, x: 216, y: 166 }]: PadPart {
            x: e.x * root.s;
            y: e.y * root.s;
            width: 14 * root.s;
            height: 8 * root.s;
            border-radius: 3 * root.s;
            glyph: "";
            btn: root.buttons[e.i];
            selected: root.is-sel(e.i);
            clicked => { root.select(root.buttons[e.i].id); }
        }

        // View / menu
        for m in [{ i: 8, x: 126 }, { i: 9, x: 162 }]: PadPart {
            x: m.x * root.s;
            y: 64 * root.s;
            width: 12 * root.s;
            height: 8 * root.s;
            border-radius: 4 * root.s;
            glyph: "";
            btn: root.buttons[m.i];
            selected: root.is-sel(m.i);
            clicked => { root.select(root.buttons[m.i].id); }
        }
    }

    // ---- lists ----------------------------------------------------------
    if root.wide: Rectangle {
        for i[n] in root.left-list: PadCallout {
            x: root.px - root.gap - root.cw;
            y: root.list-top + n * root.row-h;
            width: root.cw;
            btn: root.buttons[i];
            selected: root.is-sel(i);
            clicked => { root.select(root.buttons[i].id); }
        }
        for i[n] in root.right-list: PadCallout {
            x: root.px + root.pw + root.gap;
            y: root.list-top + n * root.row-h;
            width: root.cw;
            btn: root.buttons[i];
            selected: root.is-sel(i);
            clicked => { root.select(root.buttons[i].id); }
        }
    }
    if !root.wide: Rectangle {
        x: 12px;
        y: root.list-top;
        width: root.width - 24px;
        height: root.height - root.list-top - root.bottom-inset;
        clip: true;
        Flickable {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            content-height: 17 * root.row-h;
            property <length> col-w: (self.width - 8px) / 2;
            for i[n] in root.left-list: PadCallout {
                x: 0;
                y: n * root.row-h;
                width: parent.col-w;
                btn: root.buttons[i];
                selected: root.is-sel(i);
                clicked => { root.select(root.buttons[i].id); }
            }
            for i[n] in root.right-list: PadCallout {
                x: parent.col-w + 8px;
                y: n * root.row-h;
                width: parent.col-w;
                btn: root.buttons[i];
                selected: root.is-sel(i);
                clicked => { root.select(root.buttons[i].id); }
            }
        }
    }
}
